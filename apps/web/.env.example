# Copy to `.env` in this directory for local dev:
#   cp .env.example .env
# Vite only reads env files from apps/web/ (not the repo root).

# API base path (dev server proxies /api → backend)
# VITE_API_BASE=/api
# The service bases may be relative proxy prefixes (recommended for local dev)
# or absolute URLs when deployment provides CORS and the corresponding gateway.
# Web public APIs are routed to the runtime backend.
# VITE_BACKEND_URL=http://127.0.0.1:8000
# VITE_BUSINESS_API_BASE=/business-api
# VITE_BUSINESS_BACKEND_URL=http://127.0.0.1:18302
# VITE_KNOWLEDGE_API_BASE=/knowledge-api
# VITE_KNOWLEDGE_BACKEND_URL=http://127.0.0.1:18303
# Dify exhibition dataset and the namespace used by the QA/miss pool.
# VITE_DIFY_EXHIBITION_DATASET_ID=7f264c49-557c-414b-9de6-833eb7eede08
# VITE_DIFY_NAMESPACE_ID=default

# Optional default exhibition id; URL ?exhibitionId=... takes precedence.
# VITE_EXHIBITION_ID=

# Max chat bubbles on screen (most recent). User=right, assistant=left.
# Omit or set 0 to show full history.
VITE_CHAT_MAX_VISIBLE=2
