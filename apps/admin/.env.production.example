# Copy this file to `.env.production` before running `npm run preview`.
# Relative paths are resolved from apps/admin.
HTTPS_KEY_PATH=./ssl/ai.oaii.cn.key
HTTPS_CERT_PATH=./ssl/ai.oaii.cn_bundle.pem
# HTTPS_CA_PATH=./ssl/ca.pem

# The backend may remain HTTP when it is only reached through the local proxy.
VITE_BACKEND_URL=http://127.0.0.1:8000
VITE_ADMIN_API_MODE=real
VITE_PUBLIC_WEB_URL=https://ai.oaii.cn:5173
