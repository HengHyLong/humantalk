# Copy to `.env` in this directory for local dev:
#   cp .env.example .env
# Vite only reads env files from apps/web/ (not the repo root).

# API base path (dev server proxies /api → http://ai.oaii.cn:8210)
VITE_API_BASE=/api

# Admin-only records (Gif / knowledge / idle content) stay Mock until their
# dedicated Admin API is deployed. Digital Human Center uses the real runtime
# endpoints through the proxy above.
# VITE_ADMIN_API_MODE=mock

# Max chat bubbles on screen (most recent). User=right, assistant=left.
# Omit or set 0 to show full history.
VITE_CHAT_MAX_VISIBLE=2
