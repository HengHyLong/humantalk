# Copy to `.env` in this directory for local dev:
#   cp .env.example .env
# Vite only reads env files from apps/web/ (not the repo root).

# API base path (dev server proxies /api → http://ai.oaii.cn:8210)
VITE_API_BASE=/api
VITE_BACKEND_URL=http://127.0.0.1:8000
# Optional second backend for Admin digital assets and legacy reports.
# When set, /api-assets is proxied to this backend while /api remains on VITE_BACKEND_URL.
# VITE_ASSET_BACKEND_URL=http://127.0.0.1:8001
# Optional dedicated backend for knowledge/Dify proxy routes. Leave empty to use VITE_BACKEND_URL.
# VITE_KNOWLEDGE_BACKEND_URL=http://118.24.79.69:18303

# Admin defaults to the real /api/v1 backend. Set mock only for an isolated
# local demonstration without backend services.
# VITE_ADMIN_API_MODE=mock
# Digital-human assets, interaction configuration, reports and runtime
# monitoring use the /api/v1 Admin endpoints when real mode is enabled.

# Max chat bubbles on screen (most recent). User=right, assistant=left.
# Omit or set 0 to show full history.
VITE_CHAT_MAX_VISIBLE=2
