#!/usr/bin/env bash
# OpenTalking local QuickTalk HD deployment profile.
#
# Usage:
#   1. Copy this file to a private location outside version control.
#   2. Replace every CHANGE_ME value with a newly generated secret.
#   3. Run: source /path/to/opentalking-quicktalk-hd.env
#
# Do not reuse credentials that have been pasted into chat or committed to Git.

export DIGITAL_HUMAN_HOME=/srv/humantalk
export OPENTALKING_HOME=/srv/humantalk
export OPENTALKING_MODEL_ROOT=/srv/humantalk/models
export OPENTALKING_MODEL_REPO_ROOT=/srv/digital_human/model-repos
export OPENTALKING_RUNTIME_ROOT=/srv/digital_human/runtimes
export OPENTALKING_AVATARS_DIR=/srv/humantalk/examples/avatars

# API and Web UI
export OPENTALKING_API_HOST=0.0.0.0
export OPENTALKING_API_PORT=8210
export OPENTALKING_WEB_HOST=0.0.0.0
export OPENTALKING_WEB_PORT=5173
export VITE_BACKEND_PORT=8210

# Default realtime pipeline
export OPENTALKING_DEFAULT_MODEL=quicktalk
export OPENTALKING_TORCH_DEVICE=auto
export OPENTALKING_DEFAULT_FPS=25
export OPENTALKING_TTS_SAMPLE_RATE=16000
export OPENTALKING_TTS_STREAMING_DECODE=1

# Knowledge base / RAG
export OPENTALKING_AGENT_RAG_PROVIDER=dify
export OPENTALKING_AGENT_DIFY_BASE_URL=http://120.94.216.59/v1
export OPENTALKING_AGENT_DIFY_API_KEY=CHANGE_ME_DIFY_API_KEY
export OPENTALKING_AGENT_DIFY_DATASET_ID=0658560f-50fe-48d8-b67e-9fb3c41ea767
export OPENTALKING_AGENT_DIFY_KNOWLEDGE_BASE_ID=kb-cncc-2026
export OPENTALKING_AGENT_DIFY_DEFAULT_EXHIBITION_ID=cncc-2026
export OPENTALKING_AGENT_DIFY_DEFAULT_NAMESPACE_ID=namespace-cncc-2026

# Wav2Lip: available fallback backend
export OPENTALKING_WAV2LIP_BACKEND=local
export OPENTALKING_WAV2LIP_MODEL_ROOT=/srv/humantalk/models/wav2lip
export OPENTALKING_WAV2LIP_DEVICE=cuda:0
export OPENTALKING_WAV2LIP_BATCH_SIZE=16

# Preserve a 720x1280 avatar without downscaling. Increase this only when the
# avatar manifest and prepared reference frames actually use a larger size.
export OPENTALKING_WAV2LIP_MAX_LONG_EDGE=1280
export OPENTALKING_WAV2LIP_FACE_DET_DEVICE=cpu
export OPENTALKING_WAV2LIP_POSTPROCESS_MODE=easy_improved
export OPENTALKING_WAV2LIP_SLICE_LEN=12

# This is used by remote JPEG-sequence paths and avatar preprocessing. The
# in-process local Wav2Lip path passes raw BGR frames and avoids a JPEG round trip.
export OPENTALKING_WAV2LIP_JPEG_QUALITY=95

# Optional face enhancement. Enable only after GFPGANv1.4.pth is installed at
# the configured path; easy_enhanced costs additional GPU time per frame.
# export OPENTALKING_WAV2LIP_POSTPROCESS_MODE=easy_enhanced
# export OPENTALKING_WAV2LIP_GFPGAN_CHECKPOINT=/srv/humantalk/models/gfpgan/GFPGANv1.4.pth

# Custom avatar upload limits
export OPENTALKING_CUSTOM_AVATAR_MAX_WIDTH=1080
export OPENTALKING_CUSTOM_AVATAR_MAX_HEIGHT=1920

# WebRTC: high-quality portrait H.264 over NVENC
export OPENTALKING_WEBRTC_VIDEO_ENCODER=nvenc
export OPENTALKING_WEBRTC_VIDEO_CODEC=h264
export OPENTALKING_WEBRTC_NVENC_DEVICE=0

# p4 gives materially better quality than p1 when GPU capacity is available.
export OPENTALKING_WEBRTC_NVENC_PRESET=p4
export OPENTALKING_WEBRTC_NVENC_TUNE=ull

# Recreate the NVENC context only after a meaningful target-bitrate change.
export OPENTALKING_WEBRTC_NVENC_BITRATE_RECREATE_RATIO=0.35
export OPENTALKING_WEBRTC_NVENC_RECREATE_COOLDOWN_SECONDS=5

# High-quality realtime bitrate. If packet loss appears, reduce to 6/10 Mbps.
export OPENTALKING_WEBRTC_VIDEO_START_BITRATE=12000000
export OPENTALKING_WEBRTC_VIDEO_MAX_BITRATE=20000000
export OPENTALKING_RTC_STATS_INTERVAL_SECONDS=10
export OPENTALKING_WEBRTC_ICE_TRANSPORT_POLICY=all

# QuickTalk: active default backend.
export OPENTALKING_QUICKTALK_BACKEND=local
export OPENTALKING_QUICKTALK_ASSET_ROOT=/srv/digital_human/models/quicktalk
export OPENTALKING_QUICKTALK_MODEL_BACKEND=auto
export OPENTALKING_QUICKTALK_DEVICE=cuda:0
export OPENTALKING_QUICKTALK_HUBERT_DEVICE=cuda:1
export OPENTALKING_QUICKTALK_WORKER_CACHE=1
export OPENTALKING_QUICKTALK_SLICE_LEN=12
export OPENTALKING_QUICKTALK_RENDER_CHUNK_MS=500
export OPENTALKING_QUICKTALK_PREFETCH=1
export OPENTALKING_QUICKTALK_MAX_LONG_EDGE=1920
# Reject speaking-motion clips below 80% of the QuickTalk output dimensions.
# They would otherwise be enlarged as the whole speaking frame and look soft.
# Rejected clips fall back to the sharp primary template; lip sync remains on.
export OPENTALKING_QUICKTALK_MOTION_MIN_RESOLUTION_RATIO=0.8
# Non-25fps templates require a temporary H.264 conversion. CRF 16 avoids a
# second visible quality loss during that conversion.
export OPENTALKING_QUICKTALK_TEMPLATE_CRF=16
# Keep 256 for the current QuickTalk model export. This is the generated face
# patch size, not the full output frame size.
export OPENTALKING_QUICKTALK_RESOLUTION=256
export OPENTALKING_QUICKTALK_FPS=25

# QuickTalk face SR: run every frame because this profile assumes GPU headroom.
export OPENTALKING_QUICKTALK_FACE_SR_ENABLED=1
export OPENTALKING_QUICKTALK_FACE_SR_MODEL_PATH=/srv/humantalk/models/face-sr/realesrgan_x2plus.torchscript.pt
export OPENTALKING_QUICKTALK_FACE_SR_FP16=1
export OPENTALKING_QUICKTALK_FACE_SR_DEVICE=cuda:1
export OPENTALKING_QUICKTALK_FACE_SR_STRENGTH=0.7
export OPENTALKING_QUICKTALK_FACE_SR_TEMPORAL_ALPHA=0.7
export OPENTALKING_QUICKTALK_FACE_SR_MIN_ROI_EDGE=320
export OPENTALKING_QUICKTALK_FACE_SR_INTERVAL=1
export OPENTALKING_QUICKTALK_FACE_SR_INPUT_EDGE=256

# LLM: replace with a newly generated key before startup.
export OPENTALKING_LLM_PROVIDER=openai_compatible
export OPENTALKING_LLM_BASE_URL=https://api.qnaigc.com/v1
export OPENTALKING_LLM_API_KEY=CHANGE_ME_LLM_API_KEY
export OPENTALKING_LLM_MODEL=deepseek/deepseek-v4-pro-202606
export OPENTALKING_LLM_SYSTEM_PROMPT='你是四川博览集团的数字人助手，请准确、简洁地回答展会相关问题。'

# Speech recognition
export OPENTALKING_STT_DEFAULT_PROVIDER=sensevoice
export OPENTALKING_STT_ENABLED_PROVIDERS=sensevoice
export OPENTALKING_LOCAL_AUDIO_MODEL_ROOT=/srv/digital_human/models/local-audio
export OPENTALKING_STT_SENSEVOICE_MODEL=iic/SenseVoiceSmall
export OPENTALKING_STT_SENSEVOICE_MODEL_DIR=/srv/digital_human/models/local-audio/iic__SenseVoiceSmall
export OPENTALKING_STT_SENSEVOICE_DEVICE=cpu
export OPENTALKING_STT_PREWARM_ON_STARTUP=1

# Speech synthesis
export OPENTALKING_TTS_DEFAULT_PROVIDER=edge
export OPENTALKING_TTS_ENABLED_PROVIDERS=edge,dashscope,openai_compatible,xiaomi_mimo,local_cosyvoice,indextts
export OPENTALKING_TTS_EDGE_VOICE=zh-CN-XiaoxiaoNeural

# Playback buffering and diagnostics
export FLASHTALK_PREBUFFER_CHUNKS=1
export AUDIO2VIDEO_PLAYBACK_AUDIO_RESERVE_MS=1800
export AUDIO2VIDEO_PLAYBACK_MAX_QUEUE_FRAMES=48
export AUDIO2VIDEO_PLAYBACK_MAX_WAIT_MS=1200
export OPENTALKING_RTC_MAX_CATCHUP_MS=120
export OPENTALKING_BENCHMARK_TIMING=1

# Vidu: export every value so child processes inherit it.
export OPENTALKING_VIDU_API_KEY=CHANGE_ME_VIDU_API_KEY
export OPENTALKING_VIDU_CALL_MODE=video
export OPENTALKING_VIDU_CHARACTER_ID=1
export OPENTALKING_VIDU_PUBLIC_BASE_URL=
export OPENTALKING_VIDU_SERVICE_URL=https://api.vidu.cn
export OPENTALKING_VIDU_VOICE=Tina
